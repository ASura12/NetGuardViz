+"""Signup, login, route protection and admin user-management endpoints."""
+import pytest
+from bson import ObjectId
+from jose import jwt
+
+from app.auth import login as login_module
+from app.core import database
+from app.core.security import JWTService
+
+from .conftest import TEST_PASSWORD
+
+pytestmark = pytest.mark.integration
+
+SIGNUP = {"username": "tester1", "email": "tester1@example.com", "password": TEST_PASSWORD}
+
+
+# ───────────────────────────── Signup ─────────────────────────────
+class TestSignup:
+    def test_success_stores_a_hash_and_hides_it(self, client):
+        res = client.post("/auth/signup", json=SIGNUP)
+        assert res.status_code == 200
+        body = res.json()
+        assert body["email"] == SIGNUP["email"] and body["role"] == "user" and body["is_active"] is True
+        assert "hashed_password" not in body and "password" not in body
+        stored = database.users_collection.find_one({"email": SIGNUP["email"]})
+        assert stored["hashed_password"] != TEST_PASSWORD
+
+    def test_duplicate_email_is_rejected(self, client):
+        assert client.post("/auth/signup", json=SIGNUP).status_code == 200
+        res = client.post("/auth/signup", json={**SIGNUP, "username": "someoneelse"})
+        assert res.status_code == 400 and "already registered" in res.json()["detail"]
+
+    def test_configured_admin_email_gets_admin_role(self, client):
+        res = client.post("/auth/signup", json={**SIGNUP, "email": "Admin@Example.com"})  # case-insensitive
+        assert res.json()["role"] == "admin"
+
+    @pytest.mark.parametrize("override", [
+        {"password": "short"},                 # < 8 chars
+        {"password": "x" * 73},                # > 72 chars (bcrypt limit)
+        {"username": "abc"},                   # < 5 chars
+        {"email": "not-an-email"},
+    ])
+    def test_invalid_input_is_rejected(self, client, override):
+        assert client.post("/auth/signup", json={**SIGNUP, **override}).status_code == 422
+
+
+# ───────────────────────────── Login ─────────────────────────────
+def login(client, email="user@example.com", password=TEST_PASSWORD, ip="192.168.0.5"):
+    # A private address in X-Forwarded-For makes the login skip the (mocked) threat-intel lookup.
+    return client.post("/auth/login", data={"username": email, "password": password},
+                       headers={"x-forwarded-for": ip})
+
+
+class TestLogin:
+    def test_success_returns_a_usable_bearer_token(self, client, make_user):
+        make_user("user@example.com", role="user")
+        res = login(client)
+        assert res.status_code == 200 and res.json()["token_type"] == "bearer"
+        payload = JWTService().decode(res.json()["access_token"])
+        assert payload["sub"] == "user@example.com" and payload["role"] == "user"
+        me = client.get("/api/stats/", headers={"Authorization": f"Bearer {res.json()['access_token']}"})
+        assert me.status_code == 200
+
+    def test_wrong_password_and_unknown_user_look_identical(self, client, make_user):
+        make_user("user@example.com")
+        wrong_pw = login(client, password="WrongPassword1")
+        unknown = login(client, email="nobody@example.com")
+        assert wrong_pw.status_code == unknown.status_code == 401
+        assert wrong_pw.json() == unknown.json()  # no user enumeration
+
+    def test_private_ip_skips_threat_intel(self, client, make_user, monkeypatch):
+        make_user("user@example.com")
+        monkeypatch.setattr(login_module.intel, "check_ip",
+                            lambda ip: pytest.fail("threat intel must not be queried for private IPs"))
+        assert login(client, ip="10.1.2.3").status_code == 200
+
+    def test_login_from_malicious_ip_raises_a_siem_alert(self, client, make_user, monkeypatch):
+        make_user("user@example.com")
+        monkeypatch.setattr(login_module.intel, "check_ip", lambda ip: {
+            "alert": "MALICIOUS_IP_CONNECTION", "severity": "HIGH", "ip": ip, "abuse_score": 80})
+        assert login(client, ip="203.0.113.9").status_code == 200  # login still succeeds
+        alert = database.alerts_collection.find_one({"type": "MALICIOUS_IP_CONNECTION"})
+        assert alert["src_ip"] == "203.0.113.9"
+        assert alert["detail"] == "Suspicious login from 203.0.113.9"
+
+    def test_clean_public_ip_raises_no_alert(self, client, make_user, monkeypatch):
+        make_user("user@example.com")
+        monkeypatch.setattr(login_module.intel, "check_ip", lambda ip: {"ip": ip, "clean": True, "score": 0})
+        login(client, ip="8.8.8.8")
+        assert database.alerts_collection.count_documents({}) == 0
+
+    def test_threat_intel_outage_does_not_block_login(self, client, make_user, monkeypatch):
+        make_user("user@example.com")
+        def down(ip):
+            raise RuntimeError("AbuseIPDB unreachable")
+        monkeypatch.setattr(login_module.intel, "check_ip", down)
+        assert login(client, ip="203.0.113.9").status_code == 200
+
+    @pytest.mark.parametrize("header,expected", [
+        ("203.0.113.9, 10.0.0.1", "203.0.113.9"),   # first hop of a proxy chain
+        ("  198.51.100.4  ", "198.51.100.4"),
+    ])
+    def test_client_ip_comes_from_the_first_forwarded_hop(self, header, expected):
+        class Req:
+            headers = {"x-forwarded-for": header}
+            client = None
+        assert login_module.get_client_ip(Req()) == expected
+
+
+# ───────────────────────────── Route protection ─────────────────────────────
+class TestAuthentication:
+    def test_no_token_is_401(self, client):
+        assert client.get("/api/alerts/").status_code == 401
+
+    def test_garbage_token_is_401(self, client):
+        res = client.get("/api/alerts/", headers={"Authorization": "Bearer nope"})
+        assert res.status_code == 401 and res.json()["detail"] == "Invalid or expired token"
+
+    def test_token_for_a_deleted_user_is_401(self, client, auth_header):
+        res = client.get("/api/alerts/", headers=auth_header("ghost@example.com"))
+        assert res.status_code == 401 and res.json()["detail"] == "User not found"
+
+    def test_inactive_user_is_401(self, client, make_user, auth_header):
+        make_user("off@example.com", is_active=False)
+        res = client.get("/api/alerts/", headers=auth_header("off@example.com"))
+        assert res.status_code == 401 and res.json()["detail"] == "Inactive user"
+
+    def test_token_without_subject_is_401(self, client):
+        token = jwt.encode({"role": "admin"}, JWTService.SECRET, algorithm="HS256")
+        res = client.get("/api/alerts/", headers={"Authorization": f"Bearer {token}"})
+        assert res.status_code == 401 and res.json()["detail"] == "Invalid token payload"
+
+    def test_role_comes_from_the_database_not_the_token(self, client, make_user, auth_header):
+        make_user("plain@example.com", role="user")
+        forged = auth_header("plain@example.com", role="admin")  # token *claims* admin
+        assert client.get("/auth/users", headers=forged).status_code == 403
+
+
+# ───────────────────────────── Admin user management ─────────────────────────────
+class TestAdminUsers:
+    def test_list_users_requires_admin(self, client, user_headers, admin_headers):
+        assert client.get("/auth/users").status_code == 401
+        assert client.get("/auth/users", headers=user_headers).status_code == 403
+        res = client.get("/auth/users", headers=admin_headers)
+        assert res.status_code == 200
+        assert all("hashed_password" not in u for u in res.json()["data"])
+
+    def test_admin_can_change_a_role(self, client, make_user, admin_headers):
+        target = make_user("t@example.com", username="targetuser")
+        res = client.patch(f"/auth/users/{target['_id']}/role", json={"role": "admin"}, headers=admin_headers)
+        assert res.status_code == 200 and res.json()["user"]["role"] == "admin"
+
+    @pytest.mark.parametrize("path_id,body,status", [
+        ("not-an-object-id", {"role": "admin"}, 400),
+        (str(ObjectId()), {"role": "superuser"}, 400),     # invalid role value
+        (str(ObjectId()), {"role": "admin"}, 404),         # well-formed id, no such user
+    ])
+    def test_role_update_validation(self, client, admin_headers, path_id, body, status):
+        assert client.patch(f"/auth/users/{path_id}/role", json=body, headers=admin_headers).status_code == status
+
+    def test_admin_cannot_remove_their_own_admin_role(self, client, make_user, auth_header):
+        me = make_user("admin@example.com", role="admin", username="adminuser")
+        res = client.patch(f"/auth/users/{me['_id']}/role", json={"role": "user"},
+                           headers=auth_header("admin@example.com", "admin"))
+        assert res.status_code == 400
+
+    def test_regular_user_cannot_change_roles(self, client, make_user, user_headers):
+        target = make_user("t@example.com", username="targetuser")
+        res = client.patch(f"/auth/users/{target['_id']}/role", json={"role": "admin"}, headers=user_headers)
+        assert res.status_code == 403
+        assert database.users_collection.find_one({"_id": target["_id"]})["role"] == "user"
+
+    def test_status_must_be_boolean(self, client, make_user, admin_headers):
+        target = make_user("t@example.com", username="targetuser")
+        res = client.patch(f"/auth/users/{target['_id']}/status", json={"is_active": "no"}, headers=admin_headers)
+        assert res.status_code == 400
+
+    def test_admin_cannot_deactivate_themselves(self, client, make_user, auth_header):
+        me = make_user("admin@example.com", role="admin", username="adminuser")
+        res = client.patch(f"/auth/users/{me['_id']}/status", json={"is_active": False},
+                           headers=auth_header("admin@example.com", "admin"))
+        assert res.status_code == 400
+
+    def test_deactivated_user_is_locked_out_immediately(self, client, make_user, admin_headers, auth_header):
+        target = make_user("t@example.com", username="targetuser")
+        victim = auth_header("t@example.com")
+        assert client.get("/api/stats/", headers=victim).status_code == 200
+        client.patch(f"/auth/users/{target['_id']}/status", json={"is_active": False}, headers=admin_headers)
+        assert client.get("/api/stats/", headers=victim).status_code == 401  # same token, now refused
