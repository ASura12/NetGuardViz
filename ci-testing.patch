+"""Alerts feed, alert deletion and the /api/threats endpoints."""
+import pytest
+from bson import ObjectId
+
+from app.api import threats
+from app.core import database
+
+pytestmark = pytest.mark.integration
+
+
+def keyword_alert(owner, keywords=("error",)):
+    return database.alerts_collection.insert_one(
+        {"owner_email": owner, "log_id": "l1", "detected_keywords": list(keywords)}).inserted_id
+
+
+def wifi_alert():
+    """A SIEM alert as produced by app/wifi_capture.py: no owner_email."""
+    return database.alerts_collection.insert_one({
+        "id": "w1", "type": "DEAUTH_FLOOD", "severity": "HIGH", "source": "wifi",
+        "src_mac": "aa:bb:cc:00:00:01", "detail": "flood", "timestamp": "2026-01-01T00:00:00"}).inserted_id
+
+
+class TestAlertsFeed:
+    def test_requires_authentication(self, client):
+        assert client.get("/api/alerts/").status_code == 401
+
+    def test_user_sees_only_their_own_alerts(self, client, user_headers):
+        keyword_alert("user@example.com")
+        keyword_alert("other@example.com")
+        wifi_alert()
+        data = client.get("/api/alerts/", headers=user_headers).json()
+        assert data["total"] == 1 and data["data"][0]["owner_email"] == "user@example.com"
+
+    def test_admin_sees_everything_including_wifi_alerts(self, client, admin_headers):
+        keyword_alert("user@example.com")
+        wifi_alert()
+        data = client.get("/api/alerts/", headers=admin_headers).json()
+        assert data["total"] == 2
+        assert {"DEAUTH_FLOOD"} == {a["type"] for a in data["data"] if "type" in a}
+
+    def test_response_is_json_safe(self, client, admin_headers):
+        keyword_alert("user@example.com")
+        item = client.get("/api/alerts/", headers=admin_headers).json()["data"][0]
+        assert "_id" not in item and isinstance(item["id"], str)   # ObjectId converted to string
+        assert isinstance(item["log_id"], str)
+
+    def test_pagination_and_keyword_filter(self, client, admin_headers):
+        for _ in range(5):
+            keyword_alert("user@example.com", ("error",))
+        keyword_alert("user@example.com", ("hack",))
+        page = client.get("/api/alerts/?page=2&limit=4", headers=admin_headers).json()
+        assert page["total"] == 6 and len(page["data"]) == 2
+        hack = client.get("/api/alerts/?keyword=HACK", headers=admin_headers).json()   # case-insensitive
+        assert hack["total"] == 1
+
+    @pytest.mark.parametrize("qs", ["page=0", "limit=101"])
+    def test_pagination_bounds(self, client, admin_headers, qs):
+        assert client.get(f"/api/alerts/?{qs}", headers=admin_headers).status_code == 422
+
+
+class TestDeleteAlert:
+    def test_admin_deletes(self, client, admin_headers):
+        alert_id = keyword_alert("user@example.com")
+        assert client.delete(f"/api/alerts/{alert_id}", headers=admin_headers).status_code == 200
+        assert database.alerts_collection.count_documents({}) == 0
+
+    def test_regular_user_cannot_delete(self, client, user_headers):
+        alert_id = keyword_alert("user@example.com")
+        assert client.delete(f"/api/alerts/{alert_id}", headers=user_headers).status_code == 403
+        assert database.alerts_collection.count_documents({}) == 1
+
+    def test_error_cases(self, client, admin_headers):
+        assert client.delete("/api/alerts/bad-id", headers=admin_headers).status_code == 400
+        assert client.delete(f"/api/alerts/{ObjectId()}", headers=admin_headers).status_code == 404
+
+    def test_requires_authentication(self, client):
+        assert client.delete(f"/api/alerts/{ObjectId()}").status_code == 401
+
+
+class TestThreatsApi:
+    def test_all_endpoints_require_authentication(self, client):
+        assert client.get("/api/threats/summary").status_code == 401
+        assert client.get("/api/threats/check/8.8.8.8").status_code == 401
+        assert client.post("/api/threats/seed", json={"alert": "X", "severity": "LOW", "src_ip": "1.1.1.1"}).status_code == 401
+
+    def test_summary_counts_severities_and_includes_wifi_alerts(self, client, user_headers):
+        wifi_alert()
+        database.alerts_collection.insert_one(
+            {"id": "n1", "type": "PORT_SCAN_DETECTED", "severity": "CRITICAL", "timestamp": "2026-01-02T00:00:00"})
+        body = client.get("/api/threats/summary", headers=user_headers).json()
+        assert body["summary"] == {"LOW": 0, "MEDIUM": 0, "HIGH": 1, "CRITICAL": 1}
+        assert len(body["alerts"]) == 2 and body["alerts"][0]["id"] == "n1"   # newest first
+
+    def test_check_ip_delegates_to_threat_intel(self, client, user_headers, monkeypatch):
+        monkeypatch.setattr(threats.intel, "check_ip", lambda ip: {"ip": ip, "clean": True, "score": 0})
+        assert client.get("/api/threats/check/8.8.8.8", headers=user_headers).json() == {
+            "ip": "8.8.8.8", "clean": True, "score": 0}
+
+    def test_seed_creates_an_alert(self, client, user_headers):
+        res = client.post("/api/threats/seed", headers=user_headers,
+                          json={"alert": "PORT_SCAN_DETECTED", "severity": "HIGH", "src_ip": "10.0.0.5"})
+        assert res.status_code == 200 and res.json()["alert"]["type"] == "PORT_SCAN_DETECTED"
+        assert database.alerts_collection.count_documents({"type": "PORT_SCAN_DETECTED"}) == 1
+
+    def test_seed_is_open_to_any_authenticated_user_known_gap(self, client, user_headers):
+        """Characterisation test, docs/TEST_PLAN.md finding F6: a non-admin can inject alerts
+        into the SIEM. If /seed is restricted to admins, change this to expect 403."""
+        res = client.post("/api/threats/seed", headers=user_headers,
+                          json={"alert": "FAKE", "severity": "CRITICAL", "src_ip": "10.0.0.5"})
+        assert res.status_code == 200
+
+    def test_seed_validates_the_payload(self, client, user_headers):
+        assert client.post("/api/threats/seed", headers=user_headers, json={"alert": "X"}).status_code == 422
