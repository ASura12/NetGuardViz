+"""App-level behaviour: health route, CORS policy, email notification and the helper modules."""
+import pytest
+
+from app.core import database
+from app.utils import detector, notification
+
+
+@pytest.mark.integration
+def test_root_reports_running(client):
+    assert client.get("/").json() == {"message": "NetGuardViz Running"}
+
+
+@pytest.mark.integration
+@pytest.mark.parametrize("origin,allowed", [
+    ("http://localhost:5173", True),
+    ("https://net-guard-viz.vercel.app", True),
+    ("https://evil.example.com", False),
+])
+def test_cors_only_allows_the_known_frontends(client, origin, allowed):
+    res = client.options("/api/alerts/", headers={
+        "Origin": origin, "Access-Control-Request-Method": "GET"})
+    assert (res.headers.get("access-control-allow-origin") == origin) is allowed
+
+
+# ───────────────────────────── Notifications ─────────────────────────────
+class FakeSMTP:
+    instances = []
+
+    def __init__(self, host, port):
+        self.host, self.port, self.sent, self.logged_in, self.tls = host, port, [], None, False
+        FakeSMTP.instances.append(self)
+
+    def __enter__(self):
+        return self
+
+    def __exit__(self, *exc):
+        return False
+
+    def starttls(self):
+        self.tls = True
+
+    def login(self, user, pw):
+        self.logged_in = (user, pw)
+
+    def send_message(self, msg):
+        self.sent.append(msg)
+
+
+ALERT = {"filename": "app.log", "detected_keywords": ["attack"], "timestamp": "2026-01-01T00:00:00"}
+
+
+@pytest.mark.unit
+class TestNotification:
+    def test_missing_configuration_fails_loudly(self):
+        with pytest.raises(RuntimeError, match="SMTP_SERVER"):
+            notification.send_alert_notification(ALERT)
+
+    def test_sends_a_tls_authenticated_email(self, monkeypatch):
+        FakeSMTP.instances.clear()
+        for name, value in {"SMTP_SERVER": "smtp.test", "EMAIL_ADDRESS": "from@test",
+                            "EMAIL_PASSWORD": "pw", "TO_EMAIL": "to@test"}.items():
+            monkeypatch.setattr(notification, name, value)
+        monkeypatch.setattr(notification.smtplib, "SMTP", FakeSMTP)
+        notification.send_alert_notification(ALERT)
+        (smtp,) = FakeSMTP.instances
+        assert smtp.tls and smtp.logged_in == ("from@test", "pw")
+        (msg,) = smtp.sent
+        assert msg["To"] == "to@test" and "Security Alert" in msg["Subject"]
+        assert "app.log" in msg.get_payload()[0].get_payload()
+
+
+# ───────────────────────────── Keyword detector helper ─────────────────────────────
+@pytest.mark.integration
+class TestKeywordHelper:
+    @pytest.fixture
+    def notified(self, monkeypatch):
+        sent = []
+        monkeypatch.setattr(detector, "send_alert_notification", sent.append)
+        return sent
+
+    def test_detects_keywords_stores_alert_and_notifies(self, notified):
+        alert = detector.detect_suspicious_keywords("a.log", "Access DENIED, possible Attack")
+        assert set(alert["detected_keywords"]) == {"denied", "attack"}
+        assert database.alerts_collection.count_documents({"filename": "a.log"}) == 1
+        assert len(notified) == 1
+
+    def test_clean_content_does_nothing(self, notified):
+        assert detector.detect_suspicious_keywords("a.log", "all good") is None
+        assert database.alerts_collection.count_documents({}) == 0 and notified == []
