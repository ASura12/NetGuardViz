@@ -0,0 +1,101 @@
+"""
+Shared test setup.
+
+The suite must be hermetic: no real MongoDB, no AbuseIPDB calls, no SMTP, no secrets.
+That is achieved in three steps, all of which have to happen BEFORE `app` is imported:
+
+  1. Environment variables are forced to safe test values. They are set unconditionally
+     (not with setdefault) so a developer's real `.env` can never leak into a test run:
+     python-dotenv never overrides variables that are already set.
+  2. `pymongo.MongoClient` is swapped for `mongomock.MongoClient`, an in-memory
+     implementation with the same query API. Every module that does
+     `from app.core.database import ..._collection` then talks to it.
+  3. Network-facing objects (AbuseIPDB, SMTP) are patched per test where needed.
+"""
+import os
+
+os.environ.update({
+    "JWT_SECRET": "test-secret-not-for-production",
+    "JWT_EXPIRE_MINUTES": "30",
+    "MONGODB_URI": "mongodb://localhost:27017",
+    "MONGODB_DB_NAME": "netguardviz_test",
+    "ABUSEIPDB_API_KEY": "test-api-key",
+    "ADMIN_EMAILS": "admin@example.com",
+    # Empty (not removed) so python-dotenv will not fill them in from a local .env
