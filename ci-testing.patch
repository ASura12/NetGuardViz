@@ -0,0 +1,17 @@
+[pytest]
+# Only collect the real suite. The older test_*.py files in the repo root are
+# manual demo scripts (they run at import time and need MongoDB / network access).
+testpaths = tests
+# `.` lets tests import `app`; `scripts` lets them import make_sample_pcap.
+pythonpath = . scripts
+addopts = -ra --strict-markers
+markers =
+    unit: fast isolated tests of a single class or function
+    integration: tests that exercise several layers (HTTP API + auth + in-memory database)
+    wifi: 802.11 / Wi-Fi analysis tests
+# Warnings that come from the app's pinned dependencies / existing code, not from the tests.
+filterwarnings =
+    ignore:datetime.datetime.utcnow\(\) is deprecated:DeprecationWarning
+    ignore:'crypt' is deprecated:DeprecationWarning
+    ignore:The anyio.abc.BlockingPortal alias is deprecated:DeprecationWarning
+    ignore:The `dict` method is deprecated:pydantic.warnings.PydanticDeprecatedSince20
