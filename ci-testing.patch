+++ b/tests/test_capture_pipeline.py
@@ -0,0 +1,116 @@
+"""
+The live packet pipeline (app/capture.py): packet -> detector -> SIEM -> database.
+
+Packets are built with Scapy and fed straight to `process_packet`, so no interface, root
+privileges or network access are required.
+"""
+import pytest
+from scapy.all import ARP, Ether, IP, TCP, Raw
+
+from app import capture
+from app.core import database
+from app.detectors.arp_spoof import ARPSpoofDetector
+from app.detectors.cleartext_creds import CleartextCredDetector
+from app.detectors.port_scan import PortScanDetector
+
+pytestmark = pytest.mark.integration
+
+ATTACKER = "198.51.100.7"
+
+
+class StubIntel:
+    """Threat-intel stand-in; `bad_ips` are reported malicious."""
+    def __init__(self, bad_ips=()):
+        self.bad_ips, self.checked = set(bad_ips), []
+
+    def check_ip(self, ip):
+        self.checked.append(ip)
+        if ip in self.bad_ips:
+            return {"alert": "MALICIOUS_IP_CONNECTION", "severity": "CRITICAL", "ip": ip, "abuse_score": 99}
+        return {"ip": ip, "clean": True, "score": 0}
+
+
+@pytest.fixture
+def pipeline(monkeypatch):
+    """Fresh detector state and a stubbed threat-intel client for every test."""
+    intel = StubIntel()
+    monkeypatch.setattr(capture, "psd", PortScanDetector(threshold=15, window=60, cooldown=30))
+    monkeypatch.setattr(capture, "arp_detector", ARPSpoofDetector())
+    monkeypatch.setattr(capture, "cred", CleartextCredDetector())
+    monkeypatch.setattr(capture, "intel", intel)
+    return intel
+
+
+def syn(dport, src=ATTACKER, payload=None):
+    pkt = Ether() / IP(src=src, dst="192.168.1.10") / TCP(sport=40000, dport=dport, flags="S")
+    return pkt / Raw(payload) if payload else pkt
+
+
+def alert_types():
+    return [a["type"] for a in database.alerts_collection.find({})]
+
+
+def test_port_scan_is_detected_and_stored(pipeline):
+    for port in range(1, 21):
+        capture.process_packet(syn(port))
+    assert alert_types().count("PORT_SCAN_DETECTED") == 1          # cooldown prevents a flood of alerts
+    stored = database.alerts_collection.find_one({"type": "PORT_SCAN_DETECTED"})
+    assert stored["severity"] == "HIGH" and stored["src_ip"] == ATTACKER
+
+
+def test_normal_traffic_raises_nothing(pipeline):
+    for _ in range(50):
+        capture.process_packet(syn(443))
+    assert alert_types() == []
+
+
+def test_arp_spoofing_is_detected(pipeline):
+    def reply(mac):
+        return Ether() / ARP(op=2, psrc="192.168.1.1", hwsrc=mac)
+    capture.process_packet(reply("aa:aa:aa:aa:aa:aa"))
+    capture.process_packet(reply("bb:bb:bb:bb:bb:bb"))
+    (alert,) = database.alerts_collection.find({"type": "ARP_SPOOF_DETECTED"})
+    assert alert["severity"] == "CRITICAL" and alert["src_ip"] == "192.168.1.1"
+
+
+def test_arp_requests_are_ignored(pipeline):
+    for mac in ("aa:aa:aa:aa:aa:aa", "bb:bb:bb:bb:bb:bb"):
+        capture.process_packet(Ether() / ARP(op=1, psrc="192.168.1.1", hwsrc=mac))   # op=1 is a request
+    assert alert_types() == []
+
+
+def test_cleartext_http_credentials_are_detected(pipeline):
+    payload = b"GET / HTTP/1.1\r\nAuthorization: Basic QWxhZGRpbjpvcGVuIHNlc2FtZQ==\r\n\r\n"
+    capture.process_packet(syn(80, payload=payload))
+    assert alert_types() == ["CLEARTEXT_HTTP_AUTH"]
+
+
+def test_connections_from_malicious_ips_are_flagged(pipeline):
+    pipeline.bad_ips.add(ATTACKER)
+    capture.process_packet(syn(443))
+    stored = database.alerts_collection.find_one({"type": "MALICIOUS_IP_CONNECTION"})
+    assert stored["severity"] == "CRITICAL" and stored["src_ip"] == ATTACKER
+    assert pipeline.checked == [ATTACKER]
+
+
+def test_a_failing_threat_intel_lookup_does_not_stop_the_sniffer(pipeline, monkeypatch, capsys):
+    def down(ip):
+        raise ConnectionError("no route to AbuseIPDB")
+    monkeypatch.setattr(pipeline, "check_ip", down)
+    capture.process_packet(syn(443))                 # must not raise
+    assert "Skipped a packet" in capsys.readouterr().out
+    capture.process_packet(Ether() / ARP(op=2, psrc="192.168.1.1", hwsrc="aa:aa:aa:aa:aa:aa"))  # still alive
+
+
+def test_non_ip_packets_are_ignored(pipeline):
+    capture.process_packet(Ether())
+    assert alert_types() == [] and pipeline.checked == []
+
+
+@pytest.mark.xfail(strict=True, reason=(
+    "Known bug: process_packet() resets packet_count to 0 (and session_start) on every packet, "
+    "so the Ctrl+C throughput summary always reports 0 packets. See docs/TEST_PLAN.md, finding F3."))
+def test_packet_counter_counts_packets(pipeline):
+    for port in (80, 443, 22):
+        capture.process_packet(syn(port))
+    assert capture.packet_count == 3
