index 0000000..3c9bcb4
--- /dev/null
+++ b/tests/test_detectors.py
@@ -0,0 +1,123 @@
+"""Unit tests for the network detectors (port scan, ARP spoofing, cleartext credentials)."""
+import pytest
+
+from app.detectors.arp_spoof import ARPSpoofDetector
+from app.detectors.cleartext_creds import CleartextCredDetector
+from app.detectors.port_scan import PortScanDetector
+
+pytestmark = pytest.mark.unit
+
+BASE = 1_700_000_000.0  # realistic epoch timestamp (the detector compares against time.time())
+
+
+def feed(detector, ip, ports, start=BASE, step=0.1):
+    """Send one packet per port; return the last alert raised (or None)."""
+    last = None
+    for i, port in enumerate(ports):
+        last = detector.analyze(ip, port, start + i * step) or last
+    return last
+
+
+# ───────────────────────────── Port scan ─────────────────────────────
+class TestPortScan:
+    def test_below_threshold_is_quiet(self):
+        assert feed(PortScanDetector(threshold=15), "10.0.0.5", range(1, 15)) is None  # 14 ports
+
+    def test_alert_at_threshold(self):
+        alert = feed(PortScanDetector(threshold=15), "10.0.0.5", range(1, 16))  # 15 ports
+        assert alert["alert"] == "PORT_SCAN_DETECTED"
+        assert alert["severity"] == "HIGH"
+        assert alert["src_ip"] == "10.0.0.5"
+        assert alert["ports_hit"] == 15
+
+    def test_repeated_hits_on_one_port_are_not_a_scan(self):
+        assert feed(PortScanDetector(threshold=15), "10.0.0.5", [80] * 200) is None
+
+    def test_old_ports_expire_from_the_window(self):
+        det = PortScanDetector(threshold=15, window=60)
+        feed(det, "10.0.0.5", range(1, 11), start=BASE)                 # 10 ports
+        alert = feed(det, "10.0.0.5", range(11, 21), start=BASE + 120)  # 10 more, 2 min later
+        assert alert is None  # never 15 distinct ports inside one 60 s window
+
+    def test_cooldown_suppresses_duplicate_alerts_then_rearms(self):
+        det = PortScanDetector(threshold=15, window=60, cooldown=30)
+        assert feed(det, "10.0.0.5", range(1, 16), start=BASE) is not None
+        assert det.analyze("10.0.0.5", 100, BASE + 10) is None      # inside cooldown
+        assert det.analyze("10.0.0.5", 101, BASE + 40) is not None  # cooldown over, still scanning
+
+    def test_sources_are_tracked_independently(self):
+        det = PortScanDetector(threshold=15)
+        assert feed(det, "10.0.0.5", range(1, 11)) is None
+        assert feed(det, "10.0.0.6", range(1, 11)) is None  # 10 + 10 would be 20 if mixed up
+
+    def test_threshold_is_configurable(self):
+        assert feed(PortScanDetector(threshold=3), "10.0.0.5", [1, 2, 3]) is not None
+
+    @pytest.mark.xfail(strict=True, reason=(
+        "Known bug: last_alert defaults to 0, so a first alert is suppressed when timestamps "
+        "are smaller than the cooldown (e.g. replaying a pcap with relative timestamps). "
+        "See docs/TEST_PLAN.md, finding F2."))
+    def test_first_alert_fires_even_with_small_timestamps(self):
+        det = PortScanDetector(threshold=3, window=60, cooldown=30)
+        assert feed(det, "10.0.0.5", [1, 2, 3], start=1.0, step=1.0) is not None
+
+
+# ───────────────────────────── ARP spoofing ─────────────────────────────
+class TestARPSpoof:
+    GATEWAY, REAL, FAKE = "192.168.1.1", "aa:aa:aa:aa:aa:aa", "bb:bb:bb:bb:bb:bb"
+
+    def test_first_sighting_and_repeats_are_quiet(self):
+        det = ARPSpoofDetector()
+        assert det.analyze(self.GATEWAY, self.REAL) is None
+        assert det.analyze(self.GATEWAY, self.REAL) is None
+
+    def test_mac_change_raises_critical_alert(self):
+        det = ARPSpoofDetector()
+        det.analyze(self.GATEWAY, self.REAL)
+        alert = det.analyze(self.GATEWAY, self.FAKE)
+        assert alert["alert"] == "ARP_SPOOF_DETECTED"
+        assert alert["severity"] == "CRITICAL"
+        assert alert["ip"] == self.GATEWAY
+        assert alert["known_mac"] == self.REAL
+        assert alert["new_mac"] == self.FAKE
+
+    def test_original_binding_stays_trusted_after_a_spoof_attempt(self):
+        det = ARPSpoofDetector()
+        det.analyze(self.GATEWAY, self.REAL)
+        assert det.analyze(self.GATEWAY, self.FAKE) is not None
+        assert det.analyze(self.GATEWAY, self.REAL) is None   # legitimate host is not flagged
+        assert det.analyze(self.GATEWAY, self.FAKE) is not None  # attacker is flagged again
+
+    def test_different_ips_are_independent(self):
+        det = ARPSpoofDetector()
+        det.analyze("192.168.1.1", self.REAL)
+        assert det.analyze("192.168.1.2", self.FAKE) is None
+
+
+# ───────────────────────────── Cleartext credentials ─────────────────────────────
+class TestCleartextCreds:
+    HTTP_AUTH = "GET / HTTP/1.1\r\nHost: x\r\nAuthorization: Basic QWxhZGRpbjpvcGVuIHNlc2FtZQ==\r\n\r\n"
+
+    def test_http_basic_auth_on_port_80(self):
+        (alert,) = CleartextCredDetector().analyze(self.HTTP_AUTH, "10.0.0.9", 80)
+        assert alert["alert"] == "CLEARTEXT_HTTP_AUTH"
+        assert alert["severity"] == "HIGH"
+        assert alert["src_ip"] == "10.0.0.9"
+
+    def test_header_match_is_case_insensitive(self):
+        payload = "authorization: basic QWxhZGRpbjpvcGVuIHNlc2FtZQ=="
+        assert len(CleartextCredDetector().analyze(payload, "10.0.0.9", 80)) == 1
+
+    def test_ftp_password_on_port_21(self):
+        (alert,) = CleartextCredDetector().analyze("PASS hunter2\r\n", "10.0.0.9", 21)
+        assert alert["alert"] == "CLEARTEXT_FTP_PASSWORD"
+
+    @pytest.mark.parametrize("payload,port", [
+        ("GET / HTTP/1.1\r\nHost: example.com\r\n\r\n", 80),  # ordinary request
+        ("USER alice\r\n", 21),                              # username alone is not a secret
+        ("PASS hunter2\r\n", 80),                            # FTP syntax on the wrong port
+        ("Authorization: Basic QWxhZGRpbjpvcGVuIHNlc2FtZQ==", 443),  # only port 80 is inspected
+        ("", 80),
+    ])
+    def test_no_alert(self, payload, port):
+        assert CleartextCredDetector().analyze(payload, "10.0.0.9", port) == []
