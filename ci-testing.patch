+# ───────────────────────────── Robustness ─────────────────────────────
+def test_non_wifi_packets_are_ignored():
+    guard = WiFiGuard()
+    assert guard.analyze(Ether() / IP(dst="1.1.1.1")) == []
+    assert guard.summary()["frames"] == {}
+
+
+def test_malformed_beacon_does_not_crash():
+    pkt = RadioTap() / Dot11(type=0, subtype=8, addr1=gen.BCAST, addr2=gen.AP1, addr3=gen.AP1) / Dot11Beacon()
+    pkt.time = 1.0
+    WiFiGuard().analyze(pkt)   # must not raise: the sniffer cannot die on one odd frame
+
+
+def test_inventory_summary():
+    guard, _ = run(gen.build_packets(attack=True))
+    s = guard.summary()
+    assert {ap["bssid"] for ap in s["access_points"]} == {gen.AP1, gen.AP2, gen.EVIL}
+    campus = next(ap for ap in s["access_points"] if ap["bssid"] == gen.AP1)
+    assert campus["clients"] == 1 and "WPA2/PSK" in campus["crypto"]
+    assert s["frames"]["mgmt/12"] == 120 and s["frames"]["mgmt/8"] == 21
+
+
+def test_handshake_is_reported_after_four_eapol_frames_only():
+    frames = [gen._as_captured(gen.eapol_frame(to_ds=bool(i % 2), t=i * 0.05)) for i in range(4)]
+    _, three = run(frames[:3])
+    _, four = run(frames)
+    assert "WPA_HANDSHAKE_CAPTURED" not in names(three)
+    assert names(four) == ["WPA_HANDSHAKE_CAPTURED"]
+
