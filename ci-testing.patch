+"""AbuseIPDB client tests. `requests.get` is replaced, so nothing touches the network."""
+import pytest
+import requests
+
+from app.threat_intel import abuseipdb
+from app.threat_intel.abuseipdb import AbuseIPDB
+
+pytestmark = pytest.mark.unit
+
+
+class FakeResponse:
+    def __init__(self, payload):
+        self._payload = payload
+
+    def json(self):
+        return self._payload
+
+
+@pytest.fixture
+def api(monkeypatch):
+    """Returns (client, calls, set_score). `calls` records every outgoing request."""
+    calls = []
+    state = {"payload": {"data": {"abuseConfidenceScore": 0}}}
+
+    def fake_get(url, headers=None, params=None, timeout=None):
+        calls.append({"url": url, "headers": headers, "params": params, "timeout": timeout})
+        return FakeResponse(state["payload"])
+
+    monkeypatch.setattr(abuseipdb.requests, "get", fake_get)
+
+    def set_score(score, **extra):
+        state["payload"] = {"data": {"abuseConfidenceScore": score, **extra}}
+
+    return AbuseIPDB(api_key="k-123"), calls, set_score
+
+
+def test_clean_ip(api):
+    client, _, set_score = api
+    set_score(0)
+    assert client.check_ip("8.8.8.8") == {"ip": "8.8.8.8", "clean": True, "score": 0}
+
+
+@pytest.mark.parametrize("score,clean,severity", [
+    (25, True, None),        # boundary: 25 is still clean
+    (26, False, "HIGH"),
+    (75, False, "HIGH"),     # boundary: 75 is still HIGH
+    (76, False, "CRITICAL"),
+    (100, False, "CRITICAL"),
+])
+def test_score_thresholds(api, score, clean, severity):
+    client, _, set_score = api
+    set_score(score)
+    result = client.check_ip("203.0.113.5")
+    assert bool(result.get("clean")) is clean
+    assert result.get("severity") == severity
+
+
+def test_malicious_result_carries_context(api):
+    client, _, set_score = api
+    set_score(90, totalReports=42, countryCode="RU")
+    result = client.check_ip("203.0.113.5")
+    assert result == {
+        "alert": "MALICIOUS_IP_CONNECTION", "severity": "CRITICAL", "ip": "203.0.113.5",
+        "abuse_score": 90, "total_reports": 42, "country": "RU",
+    }
+
+
+def test_request_is_built_correctly(api):
+    client, calls, _ = api
+    client.check_ip("1.2.3.4")
+    (call,) = calls
+    assert call["url"] == AbuseIPDB.BASE_URL
+    assert call["headers"]["Key"] == "k-123"
+    assert call["params"] == {"ipAddress": "1.2.3.4", "maxAgeInDays": 90}
+    assert call["timeout"] == 5  # never hang a packet-processing loop on a slow API
+
+
+def test_results_are_cached_per_ip(api):
+    client, calls, _ = api
+    client.check_ip("1.2.3.4")
+    client.check_ip("1.2.3.4")
+    assert len(calls) == 1          # protects the API quota
+    client.check_ip("5.6.7.8")
+    assert len(calls) == 2
+
+
+def test_network_errors_propagate_to_the_caller(monkeypatch):
+    def boom(*a, **k):
+        raise requests.exceptions.Timeout("slow")
+    monkeypatch.setattr(abuseipdb.requests, "get", boom)
+    with pytest.raises(requests.exceptions.Timeout):
+        AbuseIPDB("k").check_ip("9.9.9.9")  # callers (login, capture) wrap this in try/except
+
+
+def test_api_error_payload_is_reported_as_clean_known_gap(monkeypatch):
+    """Characterisation test, see docs/TEST_PLAN.md finding F4.
+
+    When AbuseIPDB answers with an error (bad key, rate limit) there is no "data" key and the
+    client reports the IP as clean, i.e. the check fails open. If this is changed to raise or to
+    return an 'unknown' status, update this test.
+    """
+    monkeypatch.setattr(abuseipdb.requests, "get",
+                        lambda *a, **k: FakeResponse({"errors": [{"detail": "Daily rate limit exceeded"}]}))
+    assert AbuseIPDB("k").check_ip("203.0.113.77")["clean"] is True
