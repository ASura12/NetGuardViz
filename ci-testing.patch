@@ -0,0 +1,67 @@
+"""JWT service and password hashing."""
+import base64
+import json
+from datetime import datetime, timezone
+
+import pytest
+from jose import jwt
+
+from app.auth.hashing import hash_password, verify_password
+from app.core.security import JWTService
+
+pytestmark = pytest.mark.unit
+
+
+def b64(obj) -> str:
+    return base64.urlsafe_b64encode(json.dumps(obj).encode()).rstrip(b"=").decode()
+
+
+class TestJWT:
+    def test_round_trip(self):
+        svc = JWTService()
+        payload = svc.decode(svc.encode("a@example.com", "admin"))
+        assert payload["sub"] == "a@example.com"
+        assert payload["role"] == "admin"
+
+    def test_expiry_matches_configuration(self):
+        svc = JWTService()
+        exp = svc.decode(svc.encode("a@example.com", "user"))["exp"]
+        remaining = exp - datetime.now(timezone.utc).timestamp()
+        assert 29 * 60 < remaining <= 30 * 60  # JWT_EXPIRE_MINUTES=30 in the test environment
+
+    def test_expired_token_is_rejected(self, monkeypatch):
+        monkeypatch.setattr(JWTService, "EXPIRY_TIME_IN_MINUTES", -1)
+        svc = JWTService()
+        assert svc.decode(svc.encode("a@example.com", "user")) is None
+
+    def test_tampered_token_is_rejected(self):
+        svc = JWTService()
+        head, body, sig = svc.encode("a@example.com", "user").split(".")
+        forged_body = b64({"sub": "a@example.com", "role": "admin", "exp": 4102444800})
+        assert svc.decode(f"{head}.{forged_body}.{sig}") is None  # role edited, signature unchanged
+
+    def test_token_signed_with_another_secret_is_rejected(self):
+        foreign = jwt.encode({"sub": "a@example.com", "role": "admin"}, "some-other-secret", algorithm="HS256")
+        assert JWTService().decode(foreign) is None
+
+    def test_alg_none_token_is_rejected(self):
+        unsigned = f"{b64({'alg': 'none', 'typ': 'JWT'})}.{b64({'sub': 'a@example.com', 'role': 'admin'})}."
+        assert JWTService().decode(unsigned) is None
+
+    @pytest.mark.parametrize("junk", ["", "not-a-token", "a.b.c"])
+    def test_garbage_is_rejected(self, junk):
+        assert JWTService().decode(junk) is None
+
+
+class TestPasswordHashing:
+    def test_hash_is_not_the_password_and_verifies(self):
+        hashed = hash_password("Password123")
+        assert hashed != "Password123"
+        assert hashed.startswith("$2")  # bcrypt
+        assert verify_password("Password123", hashed)
+
+    def test_wrong_password_fails(self):
+        assert not verify_password("password123", hash_password("Password123"))
+
+    def test_hashes_are_salted(self):
+        assert hash_password("Password123") != hash_password("Password123")
