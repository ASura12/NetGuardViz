+++ b/tests/test_logs_api.py
@@ -0,0 +1,227 @@
+"""Log upload validation, background keyword scan, listing, soft-delete and stats."""
+from datetime import datetime
+
+import pytest
+from bson import ObjectId
+from fastapi import HTTPException
+
+from app.api import routes_logs as logs
+from app.core import database
+
+GOOD_LOG = b"2026-01-01 INFO service started\n2026-01-01 ERROR login failed for admin\n"
+CLEAN_LOG = b"2026-01-01 INFO service started\n2026-01-01 INFO heartbeat ok\n"
+
+
+def upload(client, headers, content=GOOD_LOG, name="app.log", mime="text/plain"):
+    return client.post("/api/logs/upload", headers=headers,
+                       files={"uploaded_file": (name, content, mime)})
+
+
+def status_of(fn, *args):
+    with pytest.raises(HTTPException) as exc:
+        fn(*args)
+    return exc.value.status_code
+
+
+# ───────────────────────────── Validators (unit) ─────────────────────────────
+@pytest.mark.unit
+class TestValidators:
+    @pytest.mark.parametrize("name", ["a.log", "A.TXT", "data.json", "my.app.log"])
+    def test_allowed_extensions(self, name):
+        assert logs.check_files_extension(name) in {".log", ".txt", ".json"}
+
+    @pytest.mark.parametrize("name", [None, "", "   ", "noextension", "trailingdot.", "run.exe", "a.tar.gz", "x.php"])
+    def test_rejected_extensions(self, name):
+        assert status_of(logs.check_files_extension, name) == 400
+
+    @pytest.mark.parametrize("mime", ["text/plain", "TEXT/PLAIN", "text/x-log", "application/json"])
+    def test_allowed_mime(self, mime):
+        assert logs.check_mime_type(mime) == mime.lower()
+
+    @pytest.mark.parametrize("mime", [None, "", "image/png", "application/x-msdownload"])
+    def test_rejected_mime(self, mime):
+        assert status_of(logs.check_mime_type, mime) == 400
+
+    def test_size_limits(self):
+        assert logs.check_file_size(b"x") == 1
+        assert logs.check_file_size(b"x" * (5 * 1024 * 1024)) == 5 * 1024 * 1024  # exactly 5 MB is fine
+        assert status_of(logs.check_file_size, b"") == 400
+        assert status_of(logs.check_file_size, b"x" * (5 * 1024 * 1024 + 1)) == 413
+
+    def test_read_file_normalises_line_endings(self):
+        assert logs.read_file(b"a\r\nb\rc") == "a\nb\nc"
+
+    def test_read_file_rejects_bad_encoding_and_binary(self):
+        assert status_of(logs.read_file, b"\xff\xfe\x00bad") == 400
+        assert status_of(logs.read_file, b"line1\nli\x00ne2") == 400
+
+    def test_content_must_have_at_least_two_meaningful_lines(self):
+        assert status_of(logs.validate_content_type, "   \n\n ") == 400
+        assert status_of(logs.validate_content_type, "only one line") == 400
+        assert logs.validate_content_type("\n a \n b \n") == "a \n b"
+
+    def test_split_into_lines(self):
+        assert logs.split_into_lines(None) == []
+        assert logs.split_into_lines("a\r\n\r\nb\rc\n  \n") == ["a", "b", "c"]
+
+
+@pytest.mark.integration
+class TestKeywordScan:
+    def test_flags_and_stores_an_alert(self):
+        log_id = database.logs_collection.insert_one({"filename": "f.log"}).inserted_id
+        result = logs.scan_for_suspicious_keywords(
+            "User LOGIN FAILED: Unauthorized", database.logs_collection, database.alerts_collection,
+            log_id, "o@example.com", "1", "f.log")
+        assert result["suspicious"] is True
+        assert set(result["detected_keywords"]) == {"failed", "unauthorized"}  # case-insensitive
+        assert database.logs_collection.find_one({"_id": log_id})["suspicious"] is True
+        alert = database.alerts_collection.find_one({"log_id": log_id})
+        assert alert["owner_email"] == "o@example.com"
+
+    def test_clean_content_creates_no_alert(self):
+        log_id = database.logs_collection.insert_one({"filename": "f.log"}).inserted_id
+        result = logs.scan_for_suspicious_keywords(
+            "all quiet", database.logs_collection, database.alerts_collection, log_id, "o@example.com", "1", "f.log")
+        assert result == {"suspicious": False, "detected_keywords": []}
+        assert database.alerts_collection.count_documents({}) == 0
+
+
+# ───────────────────────────── Upload (API) ─────────────────────────────
+@pytest.mark.integration
+class TestUpload:
+    def test_requires_authentication(self, client):
+        res = client.post("/api/logs/upload", files={"uploaded_file": ("a.log", GOOD_LOG, "text/plain")})
+        assert res.status_code == 401
+
+    def test_suspicious_log_is_analysed_in_the_background(self, client, user_headers):
+        res = upload(client, user_headers)
+        assert res.status_code == 200
+        log = database.logs_collection.find_one({"_id": ObjectId(res.json()["id"])})
+        assert log["owner_email"] == "user@example.com"
+        assert log["status"] == "processed"
+        assert log["suspicious"] is True and {"error", "failed"} <= set(log["detected_keywords"])
+        assert database.alerts_collection.count_documents({"owner_email": "user@example.com"}) == 1
+
+    def test_clean_log_is_processed_without_alert(self, client, user_headers):
+        res = upload(client, user_headers, content=CLEAN_LOG)
+        log = database.logs_collection.find_one({"_id": ObjectId(res.json()["id"])})
+        assert log["status"] == "processed" and log["suspicious"] is False
+        assert database.alerts_collection.count_documents({}) == 0
+
+    @pytest.mark.parametrize("kwargs,status", [
+        ({"name": "malware.exe"}, 400),
+        ({"name": "noext"}, 400),
+        ({"mime": "image/png"}, 400),
+        ({"content": b""}, 400),
+        ({"content": b"just one line"}, 400),
+        ({"content": b"\xff\xfe\xfa binary"}, 400),
+        ({"content": b"x\n" * (3 * 1024 * 1024)}, 413),   # ~6 MB
+    ])
+    def test_invalid_uploads_are_rejected_and_not_stored(self, client, user_headers, kwargs, status):
+        assert upload(client, user_headers, **kwargs).status_code == status
+        assert database.logs_collection.count_documents({}) == 0
+
+
+# ───────────────────────────── List / delete / update (API) ─────────────────────────────
+def add_log(owner="user@example.com", filename="a.log", **extra):
+    return database.logs_collection.insert_one(
+        {"owner_email": owner, "filename": filename, "content": "x\ny", "status": "processed", **extra}).inserted_id
+
+
+@pytest.mark.integration
+class TestListLogs:
+    def test_users_only_see_their_own_logs(self, client, user_headers):
+        add_log("user@example.com", "mine.log")
+        add_log("other@example.com", "theirs.log")
+        data = client.get("/api/logs/", headers=user_headers).json()
+        assert data["total"] == 1 and data["data"][0]["filename"] == "mine.log"
+        assert "_id" not in data["data"][0] and data["data"][0]["id"]
+
+    def test_soft_deleted_logs_are_hidden(self, client, user_headers):
+        add_log(filename="gone.log", is_deleted=True)
+        add_log(filename="here.log")
+        assert [l["filename"] for l in client.get("/api/logs/", headers=user_headers).json()["data"]] == ["here.log"]
+
+    def test_pagination(self, client, user_headers):
+        for i in range(5):
+            add_log(filename=f"{i}.log")
+        page2 = client.get("/api/logs/?page=2&limit=2", headers=user_headers).json()
+        assert page2["total"] == 5 and page2["page"] == 2 and len(page2["data"]) == 2
+
+    def test_filters(self, client, user_headers):
+        add_log(filename="bad.log", suspicious=True)
+        add_log(filename="ok.log", suspicious=False)
+        sus = client.get("/api/logs/?suspicious=true", headers=user_headers).json()["data"]
+        assert [l["filename"] for l in sus] == ["bad.log"]
+        named = client.get("/api/logs/?filename=ok.log", headers=user_headers).json()["data"]
+        assert [l["filename"] for l in named] == ["ok.log"]
+
+    @pytest.mark.parametrize("qs", ["page=0", "limit=101"])
+    def test_pagination_bounds(self, client, user_headers, qs):
+        assert client.get(f"/api/logs/?{qs}", headers=user_headers).status_code == 422
+
+
+@pytest.mark.integration
+class TestDeleteLog:
+    def test_owner_soft_deletes(self, client, user_headers):
+        log_id = add_log()
+        assert client.delete(f"/api/logs/{log_id}", headers=user_headers).status_code == 200
+        doc = database.logs_collection.find_one({"_id": log_id})
+        assert doc["is_deleted"] is True and "deleted_at" in doc   # kept for audit, not erased
+        assert client.get("/api/logs/", headers=user_headers).json()["total"] == 0
+
+    def test_other_users_cannot_delete(self, client, other_user_headers):
+        log_id = add_log("user@example.com")
+        assert client.delete(f"/api/logs/{log_id}", headers=other_user_headers).status_code == 403
+        assert not database.logs_collection.find_one({"_id": log_id}).get("is_deleted")
+
+    def test_admin_can_delete_any_log(self, client, admin_headers):
+        log_id = add_log("user@example.com")
+        assert client.delete(f"/api/logs/{log_id}", headers=admin_headers).status_code == 200
+
+    def test_error_cases(self, client, user_headers):
+        assert client.delete("/api/logs/not-an-id", headers=user_headers).status_code == 400
+        assert client.delete(f"/api/logs/{ObjectId()}", headers=user_headers).status_code == 404
+        deleted = add_log(is_deleted=True)
+        assert client.delete(f"/api/logs/{deleted}", headers=user_headers).status_code == 404  # already deleted
+
+    def test_requires_authentication(self, client):
+        assert client.delete(f"/api/logs/{ObjectId()}").status_code == 401
+
+
+@pytest.mark.integration
+class TestUpdateLog:
+    BODY = {"filename": "renamed.log", "content": "x\ny", "uploaded_at": datetime(2026, 1, 1).isoformat()}
+
+    def test_requires_admin(self, client, user_headers):
+        assert client.put(f"/api/logs/{ObjectId()}", json=self.BODY, headers=user_headers).status_code == 403
+
+    def test_admin_updates_own_log(self, client, admin_headers):
+        log_id = add_log("admin@example.com")
+        assert client.put(f"/api/logs/{log_id}", json=self.BODY, headers=admin_headers).status_code == 200
+        assert database.logs_collection.find_one({"_id": log_id})["filename"] == "renamed.log"
+
+    def test_invalid_and_unknown_ids(self, client, admin_headers):
+        assert client.put("/api/logs/bad-id", json=self.BODY, headers=admin_headers).status_code == 400
+        assert client.put(f"/api/logs/{ObjectId()}", json=self.BODY, headers=admin_headers).status_code == 404
+
+
+# ───────────────────────────── Stats ─────────────────────────────
+@pytest.mark.integration
+class TestStats:
+    def test_zero_logs_gives_zero_percent(self, client, user_headers):
+        assert client.get("/api/stats/", headers=user_headers).json() == {
+            "total_logs": 0, "total_alerts": 0, "suspicious_percentage": 0.0}
+
+    def test_counts_only_own_non_deleted_data(self, client, user_headers):
+        for _ in range(4):
+            add_log()
+        add_log(is_deleted=True)                       # excluded
+        add_log("other@example.com")                   # someone else's
+        database.alerts_collection.insert_one({"owner_email": "user@example.com"})
+        database.alerts_collection.insert_one({"owner_email": "other@example.com"})
+        assert client.get("/api/stats/", headers=user_headers).json() == {
+            "total_logs": 4, "total_alerts": 1, "suspicious_percentage": 25.0}
+
+    def test_requires_authentication(self, client):
+        assert client.get("/api/stats/").status_code == 401
