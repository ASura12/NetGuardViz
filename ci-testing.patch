+"""The Wi-Fi capture agent (app/wifi_capture.py) and the committed sample captures."""
+import json
+import os
+from pathlib import Path
+
+import pytest
+from scapy.all import rdpcap
+
+import make_sample_pcap as gen
+from app import wifi_capture
+from app.core import database
+from app.detectors.wifi_guard import WiFiGuard
+
+pytestmark = [pytest.mark.wifi]
+
+SAMPLES = Path(__file__).resolve().parent.parent / "samples"
+ATTACK_ALERTS = {"WEAK_WIFI_SECURITY", "EVIL_TWIN_SUSPECTED", "WPA_HANDSHAKE_CAPTURED", "DEAUTH_FLOOD"}
+
+
+class RecordingSIEM:
+    def __init__(self):
+        self.alerts = []
+
+    def ingest(self, alert):
+        self.alerts.append(alert)
+
+
+# ───────────────────── Committed sample captures (golden files) ─────────────────────
+@pytest.mark.unit
+class TestSampleCaptures:
+    def test_attack_capture_yields_exactly_the_expected_alerts(self):
+        siem = RecordingSIEM()
+        wifi_capture.run_pcap(str(SAMPLES / "sample.pcap"), WiFiGuard(), siem)
+        assert {a["alert"] for a in siem.alerts} == ATTACK_ALERTS
+        assert len(siem.alerts) == 4
+
+    def test_benign_capture_has_no_serious_alerts(self):
+        siem = RecordingSIEM()
+        wifi_capture.run_pcap(str(SAMPLES / "benign.pcap"), WiFiGuard(), siem)
+        assert not [a for a in siem.alerts if a["severity"] in ("HIGH", "CRITICAL", "MEDIUM")]
+
+    def test_committed_files_match_the_generator(self):
+        """Guards against editing scripts/make_sample_pcap.py without regenerating samples/."""
+        assert len(rdpcap(str(SAMPLES / "sample.pcap"))) == len(gen.build_packets(attack=True))
+        assert len(rdpcap(str(SAMPLES / "benign.pcap"))) == len(gen.build_packets(attack=False))
+
+
+# ───────────────────── Handler / replay ─────────────────────
+@pytest.mark.unit
+class TestHandler:
+    def test_counters(self):
+        siem = RecordingSIEM()
+        counters = wifi_capture.run_pcap(str(SAMPLES / "sample.pcap"), WiFiGuard(), siem)
+        assert counters == {"packets": 145, "alerts": 4}
+
+    def test_a_crashing_frame_is_skipped_not_fatal(self, capsys):
+        class Exploding:
+            def analyze(self, pkt):
+                raise ValueError("malformed frame")
+        handle, counters = wifi_capture.build_handler(Exploding())
+        handle(object())
+        handle(object())          # the sniffer keeps going
+        assert counters == {"packets": 2, "alerts": 0}
+        assert "Skipped a frame" in capsys.readouterr().out
+
+
+# ───────────────────── Command line ─────────────────────
+def main_with(monkeypatch, *argv):
+    monkeypatch.setattr("sys.argv", ["wifi_capture", *argv])
+    wifi_capture.main()
+
+
+@pytest.mark.integration
+class TestCli:
+    def test_a_source_is_required(self, monkeypatch):
+        with pytest.raises(SystemExit) as exc:
+            main_with(monkeypatch)
+        assert exc.value.code == 2
+
+    def test_pcap_and_iface_are_mutually_exclusive(self, monkeypatch):
+        with pytest.raises(SystemExit):
+            main_with(monkeypatch, "--pcap", "a.pcap", "--iface", "wlan0mon")
+
+    def test_dry_run_prints_alerts_and_stores_nothing(self, monkeypatch, capsys):
+        main_with(monkeypatch, "--pcap", str(SAMPLES / "sample.pcap"), "--dry-run")
+        out = capsys.readouterr().out
+        assert "DEAUTH_FLOOD" in out and "EVIL_TWIN_SUSPECTED" in out
+        assert "[SUMMARY] 145 frames, 4 alerts" in out
+        assert database.alerts_collection.count_documents({}) == 0
+
+    def test_normal_run_ingests_into_the_siem(self, monkeypatch):
+        main_with(monkeypatch, "--pcap", str(SAMPLES / "sample.pcap"))
+        stored = list(database.alerts_collection.find({"source": "wifi"}))
+        assert {a["type"] for a in stored} == ATTACK_ALERTS
+        deauth = next(a for a in stored if a["type"] == "DEAUTH_FLOOD")
+        assert deauth["severity"] == "HIGH" and deauth["src_mac"] == gen.AP1
+
+    def test_json_inventory_is_written(self, monkeypatch, tmp_path):
+        out = tmp_path / "inv.json"
+        main_with(monkeypatch, "--pcap", str(SAMPLES / "sample.pcap"), "--dry-run", "--json", str(out))
+        inv = json.loads(out.read_text())
+        assert len(inv["access_points"]) == 3 and inv["frames"]["mgmt/12"] == 120
+
+    def test_thresholds_can_be_tuned_from_the_command_line(self, monkeypatch, capsys):
+        # 120 deauths in ~2 s: a threshold above that count means no flood alert
+        main_with(monkeypatch, "--pcap", str(SAMPLES / "sample.pcap"), "--dry-run",
+                  "--deauth-threshold", "500")
+        assert "DEAUTH_FLOOD" not in capsys.readouterr().out
