+"""SIEM alert engine: normalisation, storage, severity summary and correlation."""
+import pytest
+
+from app.core.database import alerts_collection
+from app.siem.alert_engine import AlertEngine
+
+pytestmark = pytest.mark.integration  # uses the (in-memory) database
+
+
+@pytest.fixture
+def siem():
+    return AlertEngine()
+
+
+def test_ingest_normalises_and_stores(siem):
+    out = siem.ingest({"alert": "PORT_SCAN_DETECTED", "severity": "HIGH",
+                       "src_ip": "10.0.0.5", "detail": "20 ports"})
+    assert out["type"] == "PORT_SCAN_DETECTED"
+    assert out["severity"] == "HIGH"
+    assert out["src_ip"] == "10.0.0.5"
+    assert out["source"] == "network"        # default source
+    assert out["detail"] == "20 ports"
+    assert out["id"] and out["timestamp"]
+    assert "_id" not in out                  # Mongo's ObjectId must not leak to callers
+    stored = alerts_collection.find_one({"id": out["id"]})
+    assert stored["type"] == "PORT_SCAN_DETECTED"
+
+
+def test_ingest_defaults_and_ip_fallback(siem):
+    out = siem.ingest({"alert": "ARP_SPOOF_DETECTED", "ip": "192.168.1.1"})  # no severity / src_ip
+    assert out["severity"] == "LOW"
+    assert out["src_ip"] == "192.168.1.1"    # falls back to "ip"
+    assert out["detail"] == ""
+
+
+def test_wifi_alert_keeps_mac_and_source(siem):
+    out = siem.ingest({"alert": "DEAUTH_FLOOD", "severity": "HIGH", "source": "wifi",
+                       "bssid": "aa:bb:cc:00:00:01", "detail": "flood"})
+    assert out["source"] == "wifi"
+    assert out["src_mac"] == "aa:bb:cc:00:00:01"
+    assert out["src_ip"] is None
+
+
+def test_each_alert_gets_a_unique_id(siem):
+    ids = {siem.ingest({"alert": "X", "severity": "LOW"})["id"] for _ in range(5)}
+    assert len(ids) == 5
+
+
+def test_summary_counts_by_severity_and_orders_newest_first(siem):
+    for i, sev in enumerate(["LOW", "HIGH", "HIGH", "CRITICAL"]):
+        alerts_collection.insert_one({"id": str(i), "type": "T", "severity": sev,
+                                      "timestamp": f"2026-01-01T00:00:0{i}"})
+    summary = siem.get_summary()
+    assert summary["summary"] == {"LOW": 1, "MEDIUM": 0, "HIGH": 2, "CRITICAL": 1}
+    assert [a["id"] for a in summary["alerts"]] == ["3", "2", "1", "0"]
+    assert all("_id" not in a for a in summary["alerts"])
+
+
+def test_summary_lists_but_does_not_count_unknown_severities(siem):
+    alerts_collection.insert_one({"id": "x", "type": "T", "severity": "INFO", "timestamp": "2026-01-01"})
+    summary = siem.get_summary()
+    assert sum(summary["summary"].values()) == 0
+    assert len(summary["alerts"]) == 1
+
+
+class TestCorrelation:
+    def test_two_distinct_attack_types_from_one_ip_are_elevated(self, siem):
+        siem.ingest({"alert": "PORT_SCAN_DETECTED", "severity": "HIGH", "src_ip": "10.0.0.5"})
+        siem.ingest({"alert": "ARP_SPOOF_DETECTED", "severity": "CRITICAL", "src_ip": "10.0.0.5"})
+        threat = siem.correlate()["10.0.0.5"]
+        assert threat["threat_level"] == "ELEVATED"
+        assert set(threat["reasons"]) == {"PORT_SCAN_DETECTED", "ARP_SPOOF_DETECTED"}
+        assert threat["alert_count"] == 2
+
+    def test_repeating_one_attack_type_is_not_multi_vector(self, siem):
+        for _ in range(3):
+            siem.ingest({"alert": "PORT_SCAN_DETECTED", "severity": "HIGH", "src_ip": "10.0.0.5"})
+        assert siem.correlate() == {}
+
+    def test_different_ips_are_not_merged(self, siem):
+        siem.ingest({"alert": "PORT_SCAN_DETECTED", "severity": "HIGH", "src_ip": "10.0.0.5"})
+        siem.ingest({"alert": "ARP_SPOOF_DETECTED", "severity": "HIGH", "src_ip": "10.0.0.6"})
+        assert siem.correlate() == {}
+
+    def test_wifi_alerts_correlate_by_mac(self, siem):
+        mac = "de:ad:be:ef:00:01"
+        siem.ingest({"alert": "EVIL_TWIN_SUSPECTED", "severity": "CRITICAL", "source": "wifi", "src_mac": mac})
+        siem.ingest({"alert": "WEAK_WIFI_SECURITY", "severity": "MEDIUM", "source": "wifi", "src_mac": mac})
+        assert siem.correlate()[mac]["threat_level"] == "ELEVATED"
+
+    def test_keyword_log_alerts_without_a_type_are_ignored(self, siem):
+        # Alerts created from uploaded logs have no `type` / `src_ip`; they must not crash correlation.
+        alerts_collection.insert_one({"log_id": "1", "owner_email": "a@b.c", "detected_keywords": ["error"]})
+        assert siem.correlate() == {}
