+name: CI
+
+# Runs on every pull request and on every push to main.
+# See docs/TEST_PLAN.md for what is tested and why.
+on:
+  push:
+    branches: [main]
+  pull_request:
+  workflow_dispatch:
+
+# A newer push to the same branch/PR cancels the run that is still in progress.
+concurrency:
+  group: ci-${{ github.ref }}
+  cancel-in-progress: true
+
+permissions:
+  contents: read
+
+jobs:
+  backend:
+    name: Backend tests (Python ${{ matrix.python-version }})
+    runs-on: ubuntu-latest
+    timeout-minutes: 15
+    strategy:
+      fail-fast: false
+      matrix:
+        # 3.11 is what Render runs (runtime.txt); 3.12 is checked so upgrades don't surprise us.
+        # 3.13 is intentionally absent: the pinned pydantic-core 2.18.4 has no 3.13 wheel.
+        python-version: ["3.11", "3.12"]
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-python@v5
+        with:
+          python-version: ${{ matrix.python-version }}
+          cache: pip
+          cache-dependency-path: |
+            requirements.txt
+            requirements-dev.txt
+
+      - name: Install dependencies
+        run: |
+          python -m pip install --upgrade pip
+          pip install -r requirements-dev.txt
+
+      # The suite needs no MongoDB, API keys or network: tests/conftest.py swaps in an
+      # in-memory database and fake credentials.
+      - name: Run pytest with coverage
+        run: >
+          pytest
+          --cov=app --cov=services
+          --cov-report=term-missing --cov-report=xml
+          --cov-fail-under=85
+          --junitxml=pytest-report.xml
+
+      # End-to-end smoke test of the Wi-Fi CLI on the committed sample capture.
+      - name: Smoke test - Wi-Fi analyser on sample.pcap
+        run: |
+          python -m app.wifi_capture --pcap samples/sample.pcap --dry-run | tee wifi-smoke.txt
+          grep -q "DEAUTH_FLOOD" wifi-smoke.txt
+          grep -q "EVIL_TWIN_SUSPECTED" wifi-smoke.txt
+          grep -q "\[SUMMARY\] 145 frames, 4 alerts" wifi-smoke.txt
+
+      - name: Smoke test - benign capture raises no serious alerts
+        run: |
+          python -m app.wifi_capture --pcap samples/benign.pcap --dry-run | tee wifi-benign.txt
+          ! grep -qE "DEAUTH_FLOOD|EVIL_TWIN_SUSPECTED|BEACON_FLOOD" wifi-benign.txt
+
+      - name: Upload test reports
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: test-reports-py${{ matrix.python-version }}
+          path: |
+            pytest-report.xml
+            coverage.xml
+          if-no-files-found: ignore
+
+  frontend:
+    name: Frontend build
+    runs-on: ubuntu-latest
+    timeout-minutes: 10
+    defaults:
+      run:
+        working-directory: frontend
+    steps:
+      - uses: actions/checkout@v4
+
+      - uses: actions/setup-node@v4
+        with:
+          node-version: 22        # Vite 8 needs Node 20.19+ or 22.12+
+          cache: npm
+          cache-dependency-path: frontend/package-lock.json
+
+      - name: Install dependencies
+        run: npm ci
+
+      # Informational for now: the code base already has existing ESLint errors
+      # (see docs/TEST_PLAN.md, finding F9). Remove `continue-on-error` once they are fixed
+      # so lint failures start blocking merges.
+      - name: Lint (informational)
+        run: npm run lint
+        continue-on-error: true
+
+      - name: Build
+        run: npm run build
