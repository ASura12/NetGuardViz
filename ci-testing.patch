new file mode 100644
index 0000000..8c9fe0d
--- /dev/null
+++ b/tests/test_wifi_guard.py
@@ -0,0 +1,183 @@
+"""
+Wi-Fi (802.11) detector tests. Traffic comes from scripts/make_sample_pcap.py, so no hardware,
+network or capture file is needed.
+"""
+import pytest
+from scapy.all import Dot11, Dot11Beacon, Dot11Deauth, Dot11Disas, Ether, IP, RadioTap, rdpcap, wrpcap
+
+import make_sample_pcap as gen
+from app.detectors.wifi_guard import WiFiGuard
+
+pytestmark = [pytest.mark.unit, pytest.mark.wifi]
+
+
+def run(pkts, **kw):
+    guard = WiFiGuard(**kw)
+    alerts = []
+    for pkt in pkts:
+        alerts += guard.analyze(pkt)
+    return guard, alerts
+
+
+def names(alerts):
+    return [a["alert"] for a in alerts]
+
+
+def deauth_frames(count, start=0.0, step=0.01, dst=gen.CLIENT, kind=Dot11Deauth, reason=7):
+    frames = []
+    for i in range(count):
+        p = (RadioTap() / Dot11(type=0, subtype=12 if kind is Dot11Deauth else 10,
+                                addr1=dst, addr2=gen.AP1, addr3=gen.AP1) / kind(reason=reason))
+        p.time = start + i * step
+        frames.append(p)
+    return frames
+
+
+# ───────────────────────────── Attack scenario ─────────────────────────────
+def test_attack_scenario_raises_expected_alerts():
+    _, alerts = run(gen.build_packets(attack=True))
+    got = names(alerts)
+    assert got.count("DEAUTH_FLOOD") == 1, got          # one alert, not one per frame
+    assert {"EVIL_TWIN_SUSPECTED", "WEAK_WIFI_SECURITY", "WPA_HANDSHAKE_CAPTURED"} <= set(got), got
+
+    flood = next(a for a in alerts if a["alert"] == "DEAUTH_FLOOD")
+    assert flood["severity"] == "HIGH"
+    assert flood["target_mac"] == gen.CLIENT and flood["bssid"] == gen.AP1
+    twin = next(a for a in alerts if a["alert"] == "EVIL_TWIN_SUSPECTED")
+    assert twin["severity"] == "CRITICAL" and twin["bssid"] == gen.EVIL and twin["legit_bssid"] == gen.AP1
+
+    # Only the open clone is weak - the two WPA2 APs must not be flagged.
+    assert {a["bssid"] for a in alerts if a["alert"] == "WEAK_WIFI_SECURITY"} == {gen.EVIL}
+
+
+def test_benign_traffic_raises_no_serious_alerts():
+    _, alerts = run(gen.build_packets(attack=False))
+    assert not [a for a in alerts if a["severity"] in ("HIGH", "CRITICAL")], names(alerts)
+    assert not {"WEAK_WIFI_SECURITY", "EVIL_TWIN_SUSPECTED"} & set(names(alerts))
+
+
+def test_alerts_have_siem_compatible_fields():
+    _, alerts = run(gen.build_packets(attack=True))
+    assert alerts
+    for a in alerts:
+        assert a["severity"] in ("LOW", "MEDIUM", "HIGH", "CRITICAL")
+        assert a["alert"] and a["detail"] and a["source"] == "wifi"
+        assert a["timestamp"] is not None
+
+
+# ───────────────────────────── Deauth / disassoc flood ─────────────────────────────
+def test_below_threshold_does_not_alert():
+    _, alerts = run(deauth_frames(10))   # default threshold is 30
+    assert "DEAUTH_FLOOD" not in names(alerts)
+
+
+def test_threshold_is_configurable():
+    _, alerts = run(deauth_frames(10, step=0.1), deauth_threshold=5)
+    assert names(alerts) == ["DEAUTH_FLOOD"]
+
+
+def test_slow_deauths_outside_the_window_do_not_add_up():
+    # 40 frames, one every 2 s => never more than ~3 inside the 5 s window
+    _, alerts = run(deauth_frames(40, step=2.0))
+    assert alerts == []
+
+
+def test_disassociation_floods_are_detected_too():
+    _, alerts = run(deauth_frames(40, kind=Dot11Disas))
+    assert names(alerts) == ["DEAUTH_FLOOD"] and alerts[0]["frame_kind"] == "disassoc"
+
+
+def test_broadcast_target_is_called_out():
+    _, alerts = run(deauth_frames(40, dst=gen.BCAST))
+    assert "all clients" in alerts[0]["detail"]
+
+
+def test_cooldown_suppresses_repeats_then_rearms():
+    guard = WiFiGuard(cooldown=10.0)
+    first = [a for p in deauth_frames(100, step=0.01) for a in guard.analyze(p)]
+    assert len(first) == 1                                          # 100 frames in 1 s => one alert
+    later = [a for p in deauth_frames(40, start=60.0, step=0.01) for a in guard.analyze(p)]
+    assert len(later) == 1                                          # a new burst a minute later alerts again
+
+
+def test_floods_against_different_clients_are_separate_alerts():
+    other = "66:55:44:33:22:11"
+    _, alerts = run(deauth_frames(40) + deauth_frames(40, dst=other))
+    assert sorted(a["target_mac"] for a in alerts) == sorted([gen.CLIENT, other])
+
+
+# ───────────────────────────── Beacons, twins, weak security ─────────────────────────────
+def beacons(n, start=0.0, step=0.01):
+    return [gen.beacon(f"02:00:00:00:{i // 256:02x}:{i % 256:02x}", f"FakeAP-{i}", 1 + i % 11, True, start + i * step)
+            for i in range(n)]
+
+
+def test_beacon_flood_is_detected():
+    _, alerts = run([gen._as_captured(p) for p in beacons(25)])
+    flood = [a for a in alerts if a["alert"] == "BEACON_FLOOD"]
+    assert len(flood) == 1 and flood[0]["severity"] == "HIGH" and flood[0]["unique_networks"] >= 20
+
+
+def test_a_normal_neighbourhood_is_not_a_beacon_flood():
+    _, alerts = run([gen._as_captured(p) for p in beacons(8)])
+    assert "BEACON_FLOOD" not in names(alerts)
+
+
+def test_same_ssid_with_same_security_is_not_an_evil_twin():
+    # e.g. a campus network with several access points (an ESS) - legitimate
+    pkts = [gen._as_captured(gen.beacon(gen.AP1, "CampusWiFi", 6, True, 0.0)),
+            gen._as_captured(gen.beacon(gen.AP2, "CampusWiFi", 11, True, 0.1))]
+    _, alerts = run(pkts)
+    assert "EVIL_TWIN_SUSPECTED" not in names(alerts)
+
+
+def test_evil_twin_is_reported_once_however_many_beacons_it_sends():
+    pkts = [gen._as_captured(gen.beacon(gen.AP1, "CampusWiFi", 6, True, 0.0))]
+    pkts += [gen._as_captured(gen.beacon(gen.EVIL, "CampusWiFi", 6, False, 1.0 + i * 0.1)) for i in range(10)]
+    _, alerts = run(pkts)
+    assert names(alerts).count("EVIL_TWIN_SUSPECTED") == 1
+    assert names(alerts).count("WEAK_WIFI_SECURITY") == 1
+
+
+def test_hidden_ssid_networks_are_not_matched_as_twins():
+    pkts = [gen._as_captured(gen.beacon(gen.AP1, "", 6, True, 0.0)),
+            gen._as_captured(gen.beacon(gen.EVIL, "", 6, False, 0.1))]
+    _, alerts = run(pkts)
+    assert "EVIL_TWIN_SUSPECTED" not in names(alerts)
+
