+def test_pcap_round_trip(tmp_path):
+    path = tmp_path / "rt.pcap"
+    wrpcap(str(path), gen.build_packets(attack=True))
+    _, alerts = run(rdpcap(str(path)))
+    assert "DEAUTH_FLOOD" in names(alerts)
